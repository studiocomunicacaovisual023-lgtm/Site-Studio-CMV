---
import { DraftingCompass, Factory, MessageSquareText, Wrench } from "@lucide/astro";

const steps = [
  {
    icon: MessageSquareText,
    title: "Briefing",
    text: "Entendemos o espaço, a necessidade e o objetivo comercial.",
  },
  {
    icon: DraftingCompass,
    title: "Criação",
    text: "Traduzimos contexto e identidade em uma solução executável.",
  },
  {
    icon: Factory,
    title: "Produção",
    text: "Materiais, tecnologia e acabamento entram em ação.",
  },
  {
    icon: Wrench,
    title: "Instalação",
    text: "A equipe conclui cada detalhe com precisão e segurança.",
  },
];
---

<section class="process section-space" id="processo" aria-labelledby="process-title">
  <div class="container process-shell">
    <header data-reveal>
      <p class="section-kicker">Como funciona</p>
      <h2 class="section-title" id="process-title">Da ideia à instalação.</h2>
      <p class="section-intro">
        Um percurso claro reduz ruído, antecipa decisões e protege o acabamento
        do projeto.
      </p>
    </header>

    <ol class="steps">
      {steps.map(({ icon: Icon, title, text }, index) => (
        <li data-reveal style={`--reveal-delay: ${index * 70}ms`}>
          <span class="step-number">0{index + 1}</span>
          <span class="step-icon"><Icon aria-hidden="true" size={25} stroke-width={1.5} /></span>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process {
    position: relative;
    overflow: hidden;
    background: #f3f6fa;
    color: #07101b;
  }

  .process::after {
    position: absolute;
    right: -7rem;
    bottom: -13rem;
    width: 30rem;
    height: 30rem;
    border: 1px solid rgb(8 120 249 / 0.12);
    border-radius: 50%;
    content: "";
  }

  .process-shell {
    display: grid;
    align-items: start;
    grid-template-columns: minmax(17rem, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(3rem, 7vw, 7rem);
  }

  .section-title {
    max-width: 9ch;
  }

  .section-intro {
    color: #647081;
  }

  .steps {
    position: relative;
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .steps::before {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 1px;
    background: #dce3eb;
    content: "";
  }

  .steps li {
    position: relative;
    min-height: 13.5rem;
    padding: 1.4rem 2rem 2rem;
    border-left: 1px solid #dce3eb;
  }

  .steps li:nth-child(-n + 2) {
    padding-top: 0;
  }

  .steps li:nth-child(n + 3) {
    padding-top: 2.5rem;
    padding-bottom: 0;
  }

  .step-number {
    position: absolute;
    top: 0;
    right: 1rem;
    color: #c3ccd7;
    font-family: var(--font-display);
    font-size: 0.64rem;
    font-weight: 700;
  }

  .steps li:nth-child(n + 3) .step-number {
    top: 2.5rem;
  }

  .step-icon {
    display: grid;
    width: 3.8rem;
    height: 3.8rem;
    border: 1px solid rgb(8 120 249 / 0.18);
    border-radius: 1rem;
    background: rgb(8 120 249 / 0.08);
    color: var(--blue);
    place-items: center;
  }

  .steps h3 {
    margin: 1.1rem 0 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 680;
    letter-spacing: -0.035em;
  }

  .steps p {
    margin: 0.45rem 0 0;
    color: #647081;
    font-size: 0.78rem;
    line-height: 1.55;
  }

  @media (max-width: 52rem) {
    .process-shell {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 34rem) {
    .steps {
      grid-template-columns: 1fr;
    }

    .steps::before {
      display: none;
    }

    .steps li,
    .steps li:nth-child(-n + 2),
    .steps li:nth-child(n + 3) {
      display: grid;
      min-height: 0;
      align-items: start;
      grid-template-columns: auto 1fr;
      grid-template-areas:
        "icon number"
        "icon title"
        "icon text";
      gap: 0.15rem 1rem;
      padding: 1rem 0.75rem 1.15rem;
      border-bottom: 1px solid #dce3eb;
    }

    .step-number,
    .steps li:nth-child(n + 3) .step-number {
      position: static;
      grid-area: number;
      justify-self: end;
    }

    .step-icon {
      width: 3.1rem;
      height: 3.1rem;
      grid-area: icon;
    }

    .steps h3 {
      margin-top: 0.1rem;
      grid-area: title;
    }

    .steps p {
      margin-top: 0.25rem;
      grid-area: text;
    }
  }
</style>
