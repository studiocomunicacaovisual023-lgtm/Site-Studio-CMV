---
import { ArrowUpRight, MapPin, MessageCircle } from "@lucide/astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { buildWhatsAppUrl } from "../../utils/whatsapp";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<section class="projects section-space" id="projetos" aria-labelledby="projects-title">
  <div class="container">
    <header class="projects-heading" data-reveal>
      <div>
        <p class="section-kicker">Projetos</p>
        <h2 class="section-title" id="projects-title">Possibilidades que ganham forma no espaço.</h2>
      </div>
      <div class="heading-note">
        <span class="note-line" aria-hidden="true"></span>
        <p>
          Referências visuais de aplicações, materiais e acabamentos para ajudar
          você a imaginar o próximo projeto da sua marca.
        </p>
      </div>
    </header>

    <div class="project-grid">
      {projects.map((project, index) => {
        const isWide = index % 4 === 0 || index % 4 === 3;
        const projectUrl = buildWhatsAppUrl(
          `Olá! Vi no site da Studio a referência de ${project.data.title} e gostaria de conversar sobre um projeto semelhante.`,
        );

        return (
        <a class="project-card" href={projectUrl} target="_blank" rel="noreferrer" aria-label={`Conversar pelo WhatsApp sobre ${project.data.title}`} data-reveal style={`--reveal-delay: ${(index % 2) * 80}ms`}>
          <Image
            src={project.data.cover}
            alt={project.data.coverAlt}
            widths={[480, 720, 1080, 1440]}
            sizes={isWide ? "(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 58vw" : "(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 40vw"}
            format="webp"
            loading="lazy"
            quality={80}
            style={`object-position: ${project.data.coverPosition};`}
          />
          <div class="project-wash" aria-hidden="true"></div>
          <div class="project-meta">
            <div class="project-title-row">
              <h3>{project.data.title}</h3>
            </div>
            <p class="project-description">{project.data.description}</p>
            {project.data.location && (
              <span class="location"><MapPin aria-hidden="true" size={14} /> {project.data.location}</span>
            )}
            <span class="project-action"><MessageCircle aria-hidden="true" size={15} /> Conversar no WhatsApp <ArrowUpRight aria-hidden="true" size={15} /></span>
          </div>
        </a>
        );
      })}
    </div>

    <div class="portfolio-end" data-reveal>
      <span>Tem uma referência ou uma ideia própria para tirar do papel?</span>
      <a href="#contato">Quero criar algo assim <ArrowUpRight aria-hidden="true" size={17} /></a>
    </div>
  </div>
</section>

<style>
  .projects {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.025) 1px, transparent 1px) 0 0 / 8rem 100%,
      #050a12;
  }

  .projects::before {
    position: absolute;
    top: -22rem;
    left: 20%;
    width: 38rem;
    height: 38rem;
    border-radius: 50%;
    background: rgb(8 120 249 / 0.08);
    filter: blur(80px);
    content: "";
  }

  .projects-heading {
    position: relative;
    display: grid;
    align-items: end;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.55fr);
    gap: 4rem;
  }

  .section-title {
    max-width: 12ch;
  }

  .heading-note {
    display: grid;
    grid-template-columns: 2.8rem 1fr;
    gap: 0.8rem;
  }

  .note-line {
    height: 1px;
    margin-top: 0.75rem;
    background: var(--blue-bright);
    box-shadow: 0 0 12px var(--blue-bright);
  }

  .heading-note p {
    margin: 0;
    color: #8290a4;
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .project-grid {
    display: grid;
    margin-top: 3.5rem;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
  }

  .project-card {
    position: relative;
    height: clamp(19rem, 27vw, 23rem);
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 1rem;
    background: #0b121d;
    color: white;
    grid-column: span 5;
  }

  .project-card:nth-child(4n + 1),
  .project-card:nth-child(4n + 4) {
    grid-column: span 7;
  }

  .project-card :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.86) contrast(1.04);
    transition: transform 550ms cubic-bezier(0.2, 0.7, 0.2, 1), filter 300ms ease;
  }

  .project-card:hover :global(img),
  .project-card:focus-visible :global(img) {
    filter: saturate(1) contrast(1.04);
    transform: scale(1.035);
  }

  .project-card:focus-visible {
    outline-offset: 0.35rem;
  }

  .project-wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(3 7 13 / 0.02) 30%, rgb(3 7 13 / 0.92) 100%);
  }

  .project-meta {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    left: 1.25rem;
  }

  .project-title-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-title-row h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 2.1rem);
    font-weight: 630;
    letter-spacing: -0.05em;
  }

  .project-description {
    max-width: 37rem;
    margin: 0.55rem 0 0;
    color: #aeb8c6;
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .project-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.7rem;
    color: #8dccff;
    font-size: 0.75rem;
    font-weight: 760;
    opacity: 0.82;
    transition: opacity 180ms ease, transform 260ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .project-action :global(svg:last-child) {
    margin-left: 0.1rem;
  }

  .project-card:hover .project-action,
  .project-card:focus-visible .project-action {
    opacity: 1;
    transform: translateX(0.2rem);
  }

  .location {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.65rem;
    color: #8d9aab;
    font-size: 0.62rem;
  }

  .portfolio-end {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    color: #65758b;
    font-size: 0.78rem;
  }

  .portfolio-end a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #69bcff;
    font-weight: 780;
  }

  @media (max-width: 64rem) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .project-card,
    .project-card:nth-child(4n + 1),
    .project-card:nth-child(4n + 4) {
      height: 20rem;
      grid-column: auto;
    }
  }

  @media (max-width: 48rem) {
    .projects-heading,
    .project-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .project-grid {
      margin-top: 2.5rem;
    }

    .project-card,
    .project-card:nth-child(4n + 1),
    .project-card:nth-child(4n + 4) {
      height: auto;
      aspect-ratio: 16 / 10;
    }

    .portfolio-end {
      align-items: flex-start;
      flex-direction: column;
    }

    .project-meta {
      right: 1rem;
      bottom: 1rem;
      left: 1rem;
    }

    .project-description {
      font-size: 0.75rem;
    }
  }
</style>
