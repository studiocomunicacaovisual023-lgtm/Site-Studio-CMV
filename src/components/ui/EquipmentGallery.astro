---
import { Pause, Play } from "@lucide/astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  items: Array<{
    image: ImageMetadata;
    title: string;
    alt: string;
    illustrative?: boolean;
  }>;
}

const { items } = Astro.props;
const imageWidths = (width: number) => [...new Set([480, 720, 960, Math.min(1200, width)])]
  .filter((size) => size <= width).sort((a, b) => a - b);
---

<equipment-gallery role="region" aria-roledescription="carrossel" aria-label="Equipamentos de produção">
  <div class="equipment-stage" data-equipment-stage aria-live="off" aria-atomic="false">
    {items.map((item, index) => (
      <figure
        class:list={["equipment-slide", { "is-active": index === 0 }]}
        data-equipment-slide
        role="group"
        aria-roledescription="slide"
        aria-label={`${index + 1} de ${items.length}: ${item.title}`}
        aria-hidden={index !== 0}
      >
        <div class="equipment-image">
          <Image
            src={item.image}
            alt={item.alt}
            widths={imageWidths(item.image.width)}
            sizes="(max-width: 896px) 84vw, (max-width: 1440px) 44vw, 580px"
            format="webp"
            loading="lazy"
            quality={82}
          />
        </div>
        <figcaption class="equipment-caption">
          <h3>{item.title}</h3>
          <p>{item.illustrative ? "Imagem ilustrativa" : "Imagem do site atual"}</p>
        </figcaption>
      </figure>
    ))}
  </div>
  <div class="equipment-controls" data-equipment-controls hidden>
    <div class="equipment-pagination" role="group" aria-label="Selecionar equipamento">
      {items.map((item, index) => (
        <button
          type="button"
          data-equipment-select={index}
          aria-label={`Mostrar ${item.title}`}
          aria-current={index === 0 ? "true" : undefined}
        ><span aria-hidden="true"></span></button>
      ))}
    </div>
    <button class="playback-control" type="button" data-equipment-toggle aria-label="Pausar apresentação">
      <Pause class="pause-icon" size={15} aria-hidden="true" />
      <Play class="play-icon" size={15} aria-hidden="true" />
    </button>
    <span class="equipment-counter" data-equipment-counter aria-hidden="true">01 / {String(items.length).padStart(2, "0")}</span>
  </div>
</equipment-gallery>

<script>
  import { initEquipmentGallery } from "../../features/equipment-gallery/equipment-gallery";

  class EquipmentGallery extends HTMLElement {
    private cleanup: (() => void) | undefined;
    connectedCallback() {
      this.cleanup ??= initEquipmentGallery(this);
    }
    disconnectedCallback() {
      this.cleanup?.();
      this.cleanup = undefined;
    }
  }

  if (!customElements.get("equipment-gallery")) customElements.define("equipment-gallery", EquipmentGallery);
</script>

<style>
  equipment-gallery {
    position: absolute;
    inset: 0;
    display: block;
    isolation: isolate;
    color: #142438;
  }

  .equipment-stage, .equipment-slide { position: absolute; inset: 0; }
  .equipment-slide {
    margin: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 650ms ease, visibility 0s 650ms;
  }
  .equipment-slide.is-active { opacity: 1; visibility: visible; transition-delay: 0s; }
  .equipment-image {
    position: absolute;
    inset: 4.25rem 0.3rem 6.25rem;
  }
  .equipment-image :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; }
  .equipment-caption { position: absolute; right: 38%; bottom: 3.1rem; left: 1.15rem; }
  .equipment-caption h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(0.86rem, 1.3vw, 1.06rem);
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: -0.035em;
  }
  .equipment-caption p { margin: 0.25rem 0 0; color: #536579; font-size: 0.67rem; }
  .equipment-controls[hidden], .playback-control[hidden] { display: none; }
  .equipment-controls {
    position: absolute;
    z-index: 2;
    bottom: 0.4rem;
    left: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.1rem;
  }
  .playback-control {
    display: grid;
    flex: 0 0 auto;
    width: 2.25rem;
    height: 2.75rem;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 0.35rem;
    background: transparent;
    color: #536579;
    cursor: pointer;
  }
  .playback-control:hover { color: #0878f9; }
  .playback-control :global(.play-icon) { display: none; }
  equipment-gallery[data-autoplay="false"] .playback-control :global(.pause-icon) { display: none; }
  equipment-gallery[data-autoplay="false"] .playback-control :global(.play-icon) { display: block; }
  .equipment-pagination { display: flex; }
  .equipment-pagination button {
    display: grid;
    width: 1.6rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 0.4rem;
    background: transparent;
    place-items: center;
    cursor: pointer;
  }
  .equipment-pagination span { width: 0.35rem; height: 0.35rem; border-radius: 50%; background: #8296ac; transition: background 180ms ease, transform 180ms ease; }
  .equipment-pagination button[aria-current="true"] span { background: #0878f9; transform: scale(1.55); }
  .equipment-pagination button:hover span { background: #0878f9; }
  .equipment-counter { margin-left: 0.3rem; color: #536579; font-size: 0.65rem; font-weight: 750; font-variant-numeric: tabular-nums; }
  button:focus-visible { outline: 2px solid #0878f9; outline-offset: 2px; }
  @media (max-width: 35rem) {
    .equipment-image { inset: 4.5rem 0.2rem 6.5rem; }
    .equipment-caption { left: 0.85rem; right: 30%; }
    .equipment-controls { left: 0.35rem; }
    .equipment-pagination button { width: 1.5rem; }
    .playback-control { width: 1.6rem; }
    .equipment-counter { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .equipment-slide, .equipment-pagination span { transition: none; }
  }
</style>
