---
import { ArrowUpRight, MessageCircleMore } from "@lucide/astro";
import { whatsappUrl } from "../../config/company";
---

<a
  class="mobile-quote"
  href={whatsappUrl}
  target="_blank"
  rel="noreferrer"
  aria-label="Solicitar orçamento pelo WhatsApp"
  data-mobile-quote
>
  <span class="quote-icon"><MessageCircleMore aria-hidden="true" size={20} stroke-width={1.8} /></span>
  <span><small>Resposta direta</small>Solicitar orçamento</span>
  <span class="quote-arrow"><ArrowUpRight aria-hidden="true" size={18} /></span>
</a>

<script>
  const mobileQuotes = document.querySelectorAll<HTMLElement>("[data-mobile-quote]");

  mobileQuotes.forEach((quote) => {
    if (quote.dataset.mobileQuoteInitialized === "true") return;
    quote.dataset.mobileQuoteInitialized = "true";

    const hero = document.getElementById("inicio");
    const contact = document.getElementById("contato");
    if (!hero || !contact || !("IntersectionObserver" in window)) return;

    let heroVisible = true;
    let contactVisible = false;

    const render = () => {
      quote.classList.toggle("is-visible", !heroVisible && !contactVisible);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.target === hero) heroVisible = entry.isIntersecting;
          if (entry.target === contact) contactVisible = entry.isIntersecting;
        });
        render();
      },
      { threshold: 0.05, rootMargin: "-68px 0px 0px 0px" },
    );

    observer.observe(hero);
    observer.observe(contact);

    window.addEventListener("pagehide", () => observer.disconnect(), { once: true });
  });
</script>

<style>
  .mobile-quote {
    position: fixed;
    z-index: 44;
    right: var(--gutter);
    bottom: calc(0.85rem + env(safe-area-inset-bottom));
    left: var(--gutter);
    display: none;
    min-height: 3.75rem;
    align-items: center;
    grid-template-columns: auto 1fr auto;
    gap: 0.7rem;
    padding: 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 1rem;
    background: rgb(5 12 22 / 0.94);
    box-shadow: 0 22px 60px rgb(0 0 0 / 0.44), 0 0 32px rgb(8 120 249 / 0.16);
    opacity: 0;
    pointer-events: none;
    transform: translateY(calc(100% + 2rem));
    transition: opacity 220ms ease, transform 320ms cubic-bezier(0.2, 0.75, 0.2, 1);
    backdrop-filter: blur(18px);
  }

  .mobile-quote.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .mobile-quote > span:nth-child(2) {
    display: grid;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 720;
    line-height: 1.2;
  }

  .mobile-quote small {
    margin-bottom: 0.15rem;
    color: #8f9daf;
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 600;
  }

  .quote-icon,
  .quote-arrow {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    place-items: center;
  }

  .quote-icon {
    background: #e9faf0;
    color: #0da94e;
  }

  .quote-arrow {
    border: 1px solid rgb(42 157 255 / 0.28);
    background: rgb(8 120 249 / 0.16);
    color: #69bcff;
  }

  @media (max-width: 48rem) {
    .mobile-quote {
      display: grid;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-quote {
      transition: none;
    }
  }
</style>
